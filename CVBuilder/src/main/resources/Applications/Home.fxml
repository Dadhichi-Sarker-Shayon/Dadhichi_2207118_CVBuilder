<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="700" prefWidth="920" styleClass="root-pane" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Applications.controllers.HomeController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <children>
        <Label layoutX="160" layoutY="140" prefHeight="80" prefWidth="600" styleClass="home-title" text="CV Builder" />
        <Label layoutX="219.0" layoutY="220.0" prefWidth="520" styleClass="home-sub" text="Your CV Building Companion" />

        <Button fx:id="createButton" layoutX="350" layoutY="360" prefHeight="48" prefWidth="220" styleClass="primary-button" text="Create New CV" />
    </children>
</AnchorPane>
