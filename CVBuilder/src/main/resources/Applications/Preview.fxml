<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="900.0" stylesheets="@Style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Applications.controllers.PreviewController">

    <center>
        <ScrollPane fitToWidth="true" BorderPane.alignment="CENTER">

            <content>
                <VBox prefHeight="695.0" prefWidth="898.0" spacing="50.0">

                    <VBox spacing="8">
                        <Separator />
                        <Label fx:id="fullNameLabel" text="Name:" />
                    </VBox>

                    <VBox spacing="6">
                        <Separator />
                        <Label text="Contact Information" />
                        <Label fx:id="emailLabel" text="Email:" />
                        <Label fx:id="phoneLabel" text="Phone:" />
                        <Label fx:id="addressLabel" text="Address:" wrapText="true" />
                    </VBox>

                    <VBox spacing="6">
                        <Separator />
                        <Label text="Education" />
                        <Label fx:id="educationLabel" text="Write Education Here" wrapText="true" />
                    </VBox>

                    <VBox spacing="6">
                        <Separator />
                        <Label text="Skills" />
                        <Label fx:id="skillsLabel" text="Write Skill Here" wrapText="true" />
                    </VBox>

                    <VBox spacing="6">
                        <Separator />
                        <Label text="Work Experience" />
                        <Label fx:id="workLabel" prefHeight="18.0" prefWidth="123.0" text="Write Experience Here" wrapText="true" />
                    </VBox>

                    <VBox spacing="6">
                        <Separator />
                        <Label text="Projects" />
                        <Label fx:id="projectsLabel" text="Write Projects Here" wrapText="true" />
                    </VBox>

                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
