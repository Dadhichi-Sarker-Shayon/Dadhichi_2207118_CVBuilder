<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700" prefWidth="920" styleClass="root-pane" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Applications.controllers.PreviewController">

    <top>
        <Label alignment="CENTER" contentDisplay="CENTER" styleClass="page-title" text="CV Preview">
            <BorderPane.margin>
                <Insets bottom="8.0" left="400.0" right="40.0" top="20.0" />
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox prefHeight="586.0" prefWidth="918.0" spacing="12" styleClass="content-box">
                    <HBox spacing="12">
                        <ImageView fx:id="profileImage" fitHeight="100" fitWidth="100" preserveRatio="true" />
                        <VBox>
                            <Label fx:id="fullNameLabel" styleClass="preview-name" text="Full Name">
                        <VBox.margin>
                           <Insets bottom="10.0" />
                        </VBox.margin></Label>
                            <Label fx:id="emailLabel" styleClass="preview-sub" text="Email">
                        <VBox.margin>
                           <Insets bottom="10.0" />
                        </VBox.margin></Label>
                            <Label fx:id="phoneLabel" styleClass="preview-sub" text="Phone Number">
                        <VBox.margin>
                           <Insets />
                        </VBox.margin></Label>
                     <HBox.margin>
                        <Insets left="60.0" />
                     </HBox.margin>
                        </VBox>
                    </HBox>

                    <Separator />

                    <Label styleClass="section-title" text="Address">
                  <VBox.margin>
                     <Insets bottom="20.0" left="50.0" />
                  </VBox.margin></Label>
                    <Label fx:id="addressLabel" wrapText="true">
                  <VBox.margin>
                     <Insets left="50.0" />
                  </VBox.margin></Label>

                    <Label styleClass="section-title" text="Education">
                  <VBox.margin>
                     <Insets bottom="20.0" left="50.0" />
                  </VBox.margin></Label>
                    <Label fx:id="educationLabel" wrapText="true">
                  <VBox.margin>
                     <Insets left="50.0" />
                  </VBox.margin></Label>

                    <Label styleClass="section-title" text="Skills">
                  <VBox.margin>
                     <Insets bottom="40.0" left="50.0" />
                  </VBox.margin></Label>
                    <Label fx:id="skillsLabel" wrapText="true">
                  <VBox.margin>
                     <Insets left="50.0" />
                  </VBox.margin></Label>

                    <Label styleClass="section-title" text="Work Experience">
                  <VBox.margin>
                     <Insets bottom="20.0" left="50.0" />
                  </VBox.margin></Label>
                    <Label fx:id="workLabel" wrapText="true">
                  <VBox.margin>
                     <Insets left="50.0" />
                  </VBox.margin></Label>

                    <Label styleClass="section-title" text="Projects">
                  <VBox.margin>
                     <Insets bottom="40.0" left="50.0" />
                  </VBox.margin></Label>
                    <Label fx:id="projectsLabel" wrapText="true">
                  <VBox.margin>
                     <Insets left="50.0" />
                  </VBox.margin></Label>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
