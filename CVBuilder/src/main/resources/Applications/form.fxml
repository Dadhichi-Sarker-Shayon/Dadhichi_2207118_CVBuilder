<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<ScrollPane fitToWidth="true" prefHeight="939.0" prefWidth="837.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Applications.controllers.FormController"
            stylesheets="@Style.css">

    <content>
        <VBox spacing="15" styleClass="content-box" prefWidth="822.0" prefHeight="938.0">

            <Label styleClass="section-title" text="Personal Information">
                <VBox.margin>
                    <Insets left="290.0" right="50.0" />
                </VBox.margin>
            </Label>

            <HBox spacing="10" styleClass="hbox-spacing-10">
                <Button onAction="#handleUploadPhoto" text="Upload Photo" styleClass="primary-button">
                    <HBox.margin>
                        <Insets top="40.0" />
                    </HBox.margin>
                </Button>
                <ImageView fx:id="profilePreview" fitWidth="100" fitHeight="100"
                           preserveRatio="true" styleClass="image-view"/>
            </HBox>

            <Label styleClass="section-title" text="Full Name" />
            <TextField fx:id="fullNameField" promptText="Enter your full name" styleClass="text-field"/>

            <Label styleClass="section-title" text="Email" />
            <TextField fx:id="emailField" promptText="Enter email" styleClass="text-field"/>

            <Label styleClass="section-title" text="Phone" />
            <TextField fx:id="phoneField" promptText="Enter phone" styleClass="text-field"/>

            <Label styleClass="section-title" text="Address" />
            <TextArea fx:id="addressField" promptText="Enter your address" styleClass="text-area"/>

            <Label styleClass="section-title" text="Education" />
            <VBox fx:id="educationList" spacing="5"/>
            <Button text="Add Education" onAction="#addEducation" styleClass="primary-button"/>

            <Label styleClass="section-title" text="Skills" />
            <VBox fx:id="skillsList" spacing="5"/>
            <Button text="Add Skill" onAction="#addSkill" styleClass="primary-button"/>

            <Label styleClass="section-title" text="Work Experience" />
            <VBox fx:id="workList" spacing="5"/>
            <Button text="Add Work Experience" onAction="#addWorkExperience" styleClass="primary-button"/>

            <Label styleClass="section-title" text="Projects" />
            <VBox fx:id="projectsList" spacing="5"/>
            <Button text="Add Project" onAction="#addProject" styleClass="primary-button"/>

            <Button text="Generate CV" onAction="#handleSubmit" styleClass="primary-button" alignment="CENTER">
                <VBox.margin>
                    <Insets left="320.0" right="50.0"/>
                </VBox.margin>
            </Button>

            <padding>
                <Insets top="50" right="50" bottom="50" left="50"/>
            </padding>
        </VBox>
    </content>
</ScrollPane>
